    if (id < this->m_minID || id > this->m_maxID) {
        return 0;
    }

    const uint8_t* row = this->m_recordsById[id - this->m_minID];

    if (!row) {
        return 0;
    }

    if (g_clientDbPerformCompress) {
        DecompressRow(row, sizeof(T), reinterpret_cast<uint8_t*>(rec));
    } else {
        memcpy(rec, row, sizeof(T));
    }

