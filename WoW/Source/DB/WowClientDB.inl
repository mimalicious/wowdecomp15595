            int32_t id = *reinterpret_cast<const int32_t*>(&rows[i * meta->m_rowSize + meta->m_idOffset]);
            this->m_records[i] = dst;
            this->m_recordsById[id - this->m_minID] = dst;
            dst += CompressRow(reinterpret_cast<const uint8_t*>(&records[i]), sizeof(T), dst);
