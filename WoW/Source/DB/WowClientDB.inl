// OFFSET: [%0x0049E670<ItemDisplayInfoRec>, %0x004F0EB0<LightFloatBandRec>, %0x004F0EB0<LightIntBandRec>]
template <class T>
int32_t WowClientDB_RLE<T>::GetRecordByIndex(int32_t index, T* rec) const {
    if (index < 0 || index >= this->m_numRecords) {
        return 0;
    }

    const uint8_t* row = this->m_records[index];

    if (g_clientDbPerformCompress) {
        DecompressRow(row, sizeof(T), reinterpret_cast<uint8_t*>(rec));
    } else {
        memcpy(rec, row, sizeof(T));
    }

    return 1;
}

