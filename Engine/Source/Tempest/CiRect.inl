// INLINED
inline CiRect::CiRect() {
    this->minY = 0;
    this->minX = 0;
    this->maxY = 0;
    this->maxX = 0;
}

// INLINED
inline CiRect::CiRect(int32_t minY, int32_t minX, int32_t maxY, int32_t maxX) {
    this->minY = minY;
    this->minX = minX;
    this->maxY = maxY;
    this->maxX = maxX;
}
